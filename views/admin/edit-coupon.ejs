<%- include("../../views/partials/admin/header") %>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/admin-assets/css/custom-dashboard.css">
</head>

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">Edit Coupon</h2>
            <p class="text-muted small mb-0">Modify the settings for coupon code: <span class="fw-bold text-primary font-monospace"><%= findCoupon.couponCode %></span></p>
        </div>
        <a href="/admin/coupon" class="btn-modern btn-modern-neutral">
            <i class="fas fa-arrow-left me-2"></i> Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="custom-card">
                <div class="custom-card-header">
                    <span class="fw-bold"><i class="fas fa-edit me-2"></i>Coupon Configuration</span>
                </div>
                <div class="custom-card-body">
                    <form id="coupon-form" method="post" action="/admin/updateCoupon">
                        <input type="hidden" id="coupon-id" name="couponId" value="<%= findCoupon._id %>" />
                        
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted">Coupon Name / Code</label>
                            <input type="text" id="coupon-name" name="couponName" value="<%= findCoupon.couponCode %>" class="form-control" placeholder="e.g. SUMMER50" required>
                            <div id="error-coupon-name" class="text-danger small mt-1"></div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Start Date</label>
                                <input type="date" name="startDate" id="startingDate" class="form-control" required>
                                <div id="error-start-date" class="text-danger small mt-1"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Expiration Date</label>
                                <input type="date" name="endDate" id="expiringDate" class="form-control" required>
                                <div id="error-end-date" class="text-danger small mt-1"></div>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Offer Percentage (%)</label>
                                <div class="input-group">
                                    <input type="number" id="offer-price" name="offerPrice" value="<%= findCoupon.offerPrice %>" class="form-control" placeholder="1-100" min="1" max="100" required oninput="if (this.value > 100) this.value = 100">
                                    <span class="input-group-text bg-light border-start-0">%</span>
                                </div>
                                <div id="error-offer-price" class="text-danger small mt-1"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Minimum Purchase (₹)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">₹</span>
                                    <input type="number" name="minimumPrice" id="minimum-price" value="<%= findCoupon.minPrice %>" class="form-control" placeholder="0" min="0" required>
                                </div>
                                <div id="error-minimum-price" class="text-danger small mt-1"></div>
                            </div>
                        </div>

                        <div class="pt-3 border-top">
                            <button type="submit" class="btn-modern btn-modern-primary w-100 py-2">
                                <i class="fas fa-save me-2"></i> Update Coupon Settings
                            </button>
                        </div>
                        <div id="err-msg" class="text-danger small mt-2 text-center"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
    // Set dates on load
    document.addEventListener('DOMContentLoaded', () => {
        const startDate = new Date('<%= findCoupon.createdOn %>').toISOString().split('T')[0];
        const endDate = new Date('<%= findCoupon.expireOn %>').toISOString().split('T')[0];
        document.getElementById("startingDate").value = startDate;
        document.getElementById("expiringDate").value = endDate;
    });

    document.getElementById("coupon-form").addEventListener("submit", function(event) {
        event.preventDefault();
        if (validateForm()) {
            updateCoupon();
        }
    });

    function validateForm() {
        document.querySelectorAll(".text-danger.small").forEach((element) => (element.innerHTML = ""));

        const sDate = document.getElementById("startingDate").value;
        const eDate = document.getElementById("expiringDate").value;
        const sDateObj = new Date(sDate);
        const eDateObj = new Date(eDate);
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        if (sDateObj > eDateObj) {
            document.getElementById("error-end-date").innerHTML = "End date must be after start date";
            return false;
        }

        let name = document.getElementById("coupon-name").value;
        const nameRegex = /^[A-Za-z0-9]{1,50}$/;
        if (!nameRegex.test(name)) {
            document.getElementById("error-coupon-name").innerHTML = "Letters and numbers only (1-50 chars)";
            return false;
        }

        const offerPrice = parseInt(document.getElementById("offer-price").value);
        const minimumPrice = parseInt(document.getElementById("minimum-price").value);

        if (isNaN(offerPrice) || offerPrice < 1 || offerPrice > 100) {
            document.getElementById("error-offer-price").innerHTML = "Valid percentage (1-100)";
            return false;
        }

        if (isNaN(minimumPrice) || minimumPrice < 0) {
            document.getElementById("error-minimum-price").innerHTML = "Valid minimum price";
            return false;
        }

        return true;
    }

    function updateCoupon() {
        const formData = {
            couponId: document.getElementById("coupon-id").value,
            couponName: document.getElementById("coupon-name").value,
            startDate: document.getElementById("startingDate").value,
            endDate: document.getElementById("expiringDate").value,
            offerPrice: document.getElementById("offer-price").value,
            minimumPrice: document.getElementById("minimum-price").value,
        };

        $.ajax({
            url: `/admin/updateCoupon?couponId=${formData.couponId}`,
            method: "put",
            data: formData,
            success: function(response) {
                Swal.fire({
                    icon: "success",
                    title: "Updated",
                    text: "Coupon has been saved successfully!",
                    confirmButtonColor: '#4f46e5'
                }).then(() => {
                    window.location.href = "/admin/coupon";
                });
            },
            error: function(xhr) {
                let msg = "Failed to update the coupon.";
                if (xhr.responseText) {
                    try {
                        const res = JSON.parse(xhr.responseText);
                        msg = res.message || msg;
                    } catch (e) {}
                }
                Swal.fire({
                    icon: "error",
                    title: "Update Failed",
                    text: msg,
                    confirmButtonColor: '#dc2626'
                });
            },
        });
    }
</script>

<%- include("../../views/partials/admin/footer") %>