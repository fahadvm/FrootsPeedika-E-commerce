<%- include("../../views/partials/admin/header") %>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/admin-assets/css/custom-dashboard.css">
    <style>
        .coupon-form-card {
            position: sticky;
            top: 20px;
        }
    </style>
</head>

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">Coupon Management</h2>
            <p class="text-muted small mb-0">Create and manage promotional discount codes for your customers.</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Add Coupon Form -->
        <div class="col-lg-4">
            <div class="custom-card coupon-form-card">
                <div class="custom-card-header">
                    <span class="fw-bold"><i class="fas fa-ticket-alt me-2"></i>Create New Coupon</span>
                </div>
                <div class="custom-card-body">
                    <form id="couponForm" method="post" action="/admin/createCoupon" onsubmit="return validateForm(event)">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Coupon Code</label>
                            <input type="text" name="couponName" class="form-control form-control-sm" placeholder="e.g. SUMMER50" required>
                            <div id="error-coupon-name" class="text-danger small mt-1"></div>
                        </div>
                        <div class="row g-2">
                            <div class="col-6 mb-3">
                                <label class="form-label small fw-bold text-muted">Start Date</label>
                                <input type="date" name="startDate" id="startingDate" class="form-control form-control-sm" required>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label small fw-bold text-muted">End Date</label>
                                <input type="date" name="endDate" id="expiringDate" class="form-control form-control-sm" required>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-6 mb-3">
                                <label class="form-label small fw-bold text-muted">Offer %</label>
                                <input type="number" name="offerPrice" class="form-control form-control-sm" placeholder="1-100" max="100" required>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label small fw-bold text-muted">Min Purchase</label>
                                <input type="number" name="minimumPrice" class="form-control form-control-sm" placeholder="₹ Min" required>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label small fw-bold text-muted">Max Purchase</label>
                                <input type="number" name="maximumPrice" class="form-control form-control-sm" placeholder="₹ Max" required>
                            </div>
                        </div>
                        <button class="btn-modern btn-modern-primary w-100 py-2 mt-2" type="submit">
                            Add Coupon
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Coupon List -->
        <div class="col-lg-8">
            <div class="custom-card">
                <div class="custom-card-header">
                    <span class="fw-bold"><i class="fas fa-list me-2"></i>Active Coupons</span>
                </div>
                <div class="modern-table-container">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Validity</th>
                                <th>Offer</th>
                                <th>Min Buy</th>
                                <th>Max Buy</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(coupons && coupons.length > 0) { %>
                                <% for(let i=0; i<coupons.length; i++){ %>
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-primary font-monospace"><%= coupons[i].couponCode %></span>
                                        </td>
                                        <td data-label="Validity">
                                            <div class="d-flex flex-column">
                                                <span class="small text-muted"><%= new Date(coupons[i].createdOn).toLocaleDateString('en-IN') %></span>
                                                <span class="small fw-bold text-dark">to <%= new Date(coupons[i].expireOn).toLocaleDateString('en-IN') %></span>
                                            </div>
                                        </td>
                                        <td data-label="Offer">
                                            <span class="badge bg-success"><%= coupons[i].offerPrice %>% OFF</span>
                                        </td>
                                        <td data-label="Min Buy">
                                            <span class="text-dark">₹<%= coupons[i].minPrice %></span>
                                        </td>
                                        <td data-label="Max Buy">
                                            <span class="text-dark">₹<%= coupons[i].maxPrice %></span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a href="/admin/editCoupon?id=<%= coupons[i]._id %>" class="btn-modern btn-modern-neutral py-1 px-2" style="font-size: 11px;">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button onclick="confirmDelete('<%= coupons[i]._id %>')" class="btn-modern btn-modern-danger py-1 px-2" style="font-size: 11px;">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            <% } else { %>
                                <tr><td colspan="5" class="text-center py-5 text-muted">No coupons found</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
    function validateForm(e) {
        const sDate = new Date(document.getElementById("startingDate").value);
        const eDate = new Date(document.getElementById("expiringDate").value);
        if (sDate > eDate) {
            Swal.fire('Error', 'End date must be after start date', 'error');
            return false;
        }
        return true;
    }

    function confirmDelete(id) {
        Swal.fire({
            title: 'Delete Coupon?',
            text: "User won't be able to use this code anymore!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: `/admin/deletecoupon?id=${id}`,
                    method: "DELETE",
                    success: () => location.reload()
                });
            }
        });
    }

    // Set default date
    document.addEventListener('DOMContentLoaded', () => {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById("startingDate").value = today;
    });
</script>

<%- include("../../views/partials/admin/footer") %>