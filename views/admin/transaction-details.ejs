<%- include("../../views/partials/admin/header") %>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/admin-assets/css/custom-dashboard.css">
    <style>
        .info-label {
            font-size: 11px;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 4px;
        }
        .info-value {
            font-size: 14px;
            color: #111827;
            font-weight: 500;
        }
        .info-card {
            padding: 1.5rem;
            height: 100%;
        }
        .status-pill {
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
    </style>
</head>

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">Transaction Audit</h2>
            <p class="text-muted small mb-0">Detailed breakdown of transactional activity for ID: <span class="font-monospace text-primary fw-bold"><%= transaction.transactionId %></span></p>
        </div>
        <a href="/admin/transactions" class="btn-modern btn-modern-neutral">
            <i class="fas fa-arrow-left me-2"></i> Back to Ledger
        </a>
    </div>

    <div class="row g-4 mb-4">
        <!-- Transaction Summary Card -->
        <div class="col-lg-8">
            <div class="custom-card info-card">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <span class="fw-bold"><i class="fas fa-file-invoice-dollar me-2 text-primary"></i>Payment Details</span>
                    <span class="status-pill <%= 
                        transaction.status === 'completed' ? 'bg-success-light text-success' : 
                        (transaction.status === 'pending' ? 'bg-warning-light text-warning' : 'bg-danger-light text-danger') 
                    %>">
                        <%= transaction.status %>
                    </span>
                </div>
                
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="info-label">Amount</div>
                        <div class="info-value fs-4 fw-bold <%= transaction.transactionType === 'credit' ? 'text-success' : 'text-danger' %>">
                            <%= transaction.transactionType === 'credit' ? '+' : '-' %>₹<%= transaction.amount.toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-label">Transaction Type</div>
                        <div class="info-value">
                            <span class="badge <%= transaction.transactionType === 'credit' ? 'bg-success' : 'bg-danger' %> rounded-pill" style="font-size: 10px;">
                                <%= transaction.transactionType.toUpperCase() %>
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-label">Timestamp</div>
                        <div class="info-value">
                            <%= new Date(transaction.createdAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="info-label">Payment Method</div>
                        <div class="info-value d-flex align-items-center">
                            <i class="fas <%= transaction.paymentMethod === 'wallet' ? 'fa-wallet' : 'fa-credit-card' %> me-2 text-muted"></i>
                            <%= transaction.paymentMethod.toUpperCase() %>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-label">Gateway</div>
                        <div class="info-value"><%= transaction.paymentGateway.toUpperCase() %></div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-label">Gateway ID</div>
                        <div class="info-value font-monospace small"><%= transaction.gatewayTransactionId || 'Internal' %></div>
                    </div>

                    <div class="col-12">
                        <div class="info-label">Purpose & Description</div>
                        <div class="info-value p-3 bg-light rounded border">
                            <span class="fw-bold text-primary"><%= transaction.purpose.replace('_', ' ').toUpperCase() %></span>
                            <p class="mb-0 mt-1 text-muted small"><%= transaction.description || 'No detailed description provided.' %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- User Profile Card -->
        <div class="col-lg-4">
            <div class="custom-card info-card">
                <div class="ms-1 mb-4 pb-3 border-bottom fw-bold">
                    <i class="fas fa-user-circle me-2 text-primary"></i>Customer Profile
                </div>
                
                <% if (transaction.userId) { %>
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; font-size: 20px;">
                            <%= transaction.userId.username.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <div class="info-value fs-5"><%= transaction.userId.username %></div>
                            <div class="text-muted small">Customer since <%= new Date(transaction.userId.createdAt).getFullYear() %></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="info-label">Email Address</div>
                        <div class="info-value"><%= transaction.userId.email %></div>
                    </div>
                    <div class="mb-3">
                        <div class="info-label">Phone Number</div>
                        <div class="info-value"><%= transaction.userId.phone || 'N/A' %></div>
                    </div>
                    
                    <% if (transaction.walletBalanceAfter !== null) { %>
                        <div class="mt-4 p-3 rounded bg-primary-light">
                            <div class="info-label text-primary">Wallet Post-Transaction</div>
                            <div class="info-value fw-bold text-primary">₹<%= transaction.walletBalanceAfter.toLocaleString() %></div>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="text-center py-4">
                        <i class="fas fa-robot fs-1 text-muted mb-3"></i>
                        <p class="text-muted">System Generated Transaction</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Related Orders -->
    <% if (orderDetails && orderDetails.length > 0) { %>
        <div class="custom-card mt-4">
            <div class="custom-card-header">
                <span class="fw-bold"><i class="fas fa-shopping-bag me-2"></i>Linked Orders</span>
            </div>
            <div class="modern-table-container">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orderDetails.forEach(order => { %>
                            <tr>
                                <td>
                                    <span class="fw-bold font-monospace">#<%= order.orderId %></span>
                                </td>
                                <td data-label="Amount">
                                    <span class="text-dark fw-bold">₹<%= order.finalAmount.toLocaleString() %></span>
                                </td>
                                <td data-label="Status">
                                    <span class="badge <%= 
                                        order.status === 'delivered' ? 'bg-success' : 
                                        (order.status === 'cancelled' ? 'bg-danger' : 'bg-info') 
                                    %>">
                                        <%= order.status %>
                                    </span>
                                </td>
                                <td data-label="Date">
                                    <span class="text-muted small"><%= new Date(order.createdAt).toLocaleDateString() %></span>
                                </td>
                                <td class="text-end">
                                    <a href="/admin/orders/<%= order._id %>" class="btn-modern btn-modern-neutral py-1 px-3">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</div>

<%- include("../../views/partials/admin/footer") %>