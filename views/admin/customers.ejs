<%- include("../../views/partials/admin/header") %>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/admin-assets/css/custom-dashboard.css">
</head>

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">Customer Management</h2>
            <p class="text-muted small mb-0">View and manage your registered customers.</p>
        </div>
        <div class="search-wrapper">
            <i class="fa fa-search search-icon"></i>
            <input type="text" class="modern-search-input" id="searchInput" placeholder="Search customers..." value="<%= locals.search || '' %>">
        </div>
    </div>

    <div class="custom-card">
        <div class="custom-card-header">
            <span class="fw-bold"><i class="fas fa-users me-2"></i>Customer List</span>
        </div>
        <div class="modern-table-container">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Customer Info</th>
                        <th>Email Address</th>
                        <th>Phone Number</th>
                        <th>Account Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="customerTableBody">
                    <% if(data && data.length > 0) { %>
                        <% for(let i=0; i < data.length; i++) { %>
                            <tr>
                                <td data-label="Customer">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="user-avatar bg-light d-flex align-items-center justify-content-center bg-primary-light text-primary" style="width:36px; height:36px; border-radius: 50%;">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark text-truncate-custom"><%= data[i].username %></span>
                                            <span class="text-muted small">ID: <%= data[i]._id.toString().slice(-6).toUpperCase() %></span>
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Email">
                                    <span class="text-dark"><%= data[i].email %></span>
                                </td>
                                <td data-label="Phone">
                                    <span class="text-dark"><%= data[i].phone || 'N/A' %></span>
                                </td>
                                <td data-label="Status">
                                    <% if(!data[i].isBlocked) { %>
                                        <span class="badge bg-success">Active</span>
                                    <% } else { %>
                                        <span class="badge bg-danger">Blocked</span>
                                    <% } %>
                                </td>
                                <td data-label="Actions">
                                    <div class="d-flex gap-2">
                                        <% if(!data[i].isBlocked) { %>
                                            <button onclick="confirmBlock(event, '<%= data[i]._id %>')" class="btn-modern btn-modern-danger py-1 px-3" style="font-size: 11px;">
                                                <i class="fas fa-ban"></i> Block
                                            </button>
                                        <% } else { %>
                                            <button onclick="confirmUnblock(event, '<%= data[i]._id %>')" class="btn-modern btn-modern-primary py-1 px-3" style="font-size: 11px;">
                                                <i class="fas fa-check-circle"></i> Unblock
                                            </button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    <% } else { %>
                        <tr><td colspan="5" class="text-center py-5">No customers found</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <nav class="mt-4">
        <ul class="modern-pagination">
            <% for(let i=1; i <=totalPages; i++) { %>
                <li class="modern-page-item <%= (i === currentPage) ? 'active' : '' %>">
                    <a class="modern-page-link" href="?page=<%= i %><%= locals.search ? '&search=' + search : '' %>"><%= i %></a>
                </li>
            <% } %>
        </ul>
    </nav>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmBlock(event, userId) {
        event.preventDefault();
        Swal.fire({
            title: "Block Customer?",
            text: "This user will lose access to their account.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#dc2626",
            confirmButtonText: "Yes, Block it"
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/admin/customers/${userId}/block`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isBlocked: true })
                }).then(res => {
                    if (res.ok) Swal.fire('Blocked!', 'User blocked successfully.', 'success').then(() => location.reload());
                });
            }
        });
    }

    function confirmUnblock(event, userId) {
        event.preventDefault();
        Swal.fire({
            title: "Unblock Customer?",
            text: "This user will regain access to their account.",
            icon: "info",
            showCancelButton: true,
            confirmButtonColor: "#4f46e5",
            confirmButtonText: "Yes, Unblock"
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/admin/customers/${userId}/unblock`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isBlocked: false })
                }).then(res => {
                    if (res.ok) Swal.fire('Unblocked!', 'User unblocked successfully.', 'success').then(() => location.reload());
                });
            }
        });
    }

    // Search logic
    const searchInput = document.getElementById('searchInput');
    let debounceTimer;
    searchInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(async () => {
            const query = searchInput.value.trim();
            window.location.href = `?search=${query}`;
        }, 800);
    });
</script>

<%- include("../../views/partials/admin/footer") %>