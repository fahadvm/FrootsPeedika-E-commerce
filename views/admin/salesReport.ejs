<%- include('../partials/admin/header') %>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/admin-assets/css/custom-dashboard.css">
    <style>
        .report-stats-card {
            background: #fff;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            height: 100%;
            border: 1px solid #f0f0f0;
            transition: transform 0.2s ease;
        }
        .report-stats-card:hover {
            transform: translateY(-5px);
        }
        .report-stats-card .icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            font-size: 1.25rem;
        }
        .icon-sales { background: rgba(52, 152, 219, 0.1); color: #3498db; }
        .icon-revenue { background: rgba(46, 204, 113, 0.1); color: #2ecc71; }
        .icon-discount { background: rgba(231, 76, 60, 0.1); color: #e74c3c; }
        
        .stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
        }
        .stat-label {
            color: #6b7280;
            font-size: 0.875rem;
            font-weight: 500;
        }
        
        .filter-pill {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 50px;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            color: #374151;
            transition: all 0.2s;
            cursor: pointer;
        }
        .filter-pill.active {
            background: #4f46e5;
            color: #fff;
            border-color: #4f46e5;
        }
        
        .custom-date-container {
            background: #f9fafb;
            padding: 1rem;
            border-radius: 10px;
            border: 1px dashed #d1d5db;
        }
    </style>
</head>

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">Sales Intelligence</h2>
            <p class="text-muted small mb-0">Track performance metrics and generate detailed reports</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn-modern btn-modern-neutral" onclick="downloadExcel()">
                <i class="fas fa-file-excel me-2"></i> Excel
            </button>
            <button class="btn-modern btn-modern-primary" onclick="downloadPDF()">
                <i class="fas fa-file-pdf me-2"></i> PDF Report
            </button>
        </div>
    </div>

    <!-- Analytics Summary -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="report-stats-card">
                <div class="icon icon-sales">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="stat-value" id="salesCount">0</div>
                <div class="stat-label">Total Orders</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="report-stats-card">
                <div class="icon icon-revenue">
                    <i class="fas fa-indian-rupee-sign"></i>
                </div>
                <div class="stat-value">₹<span id="orderAmount">0.00</span></div>
                <div class="stat-label">Total Revenue</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="report-stats-card">
                <div class="icon icon-discount">
                    <i class="fas fa-tags"></i>
                </div>
                <div class="stat-value">₹<span id="discountAmount">0.00</span></div>
                <div class="stat-label">Total Discounts</div>
            </div>
        </div>
    </div>

    <!-- Generator Section -->
    <div class="custom-card mb-4">
        <div class="custom-card-header">
            <span class="fw-bold"><i class="fas fa-filter me-2 text-primary"></i>Report Configuration</span>
        </div>
        <div class="custom-card-body">
            <div class="row align-items-center g-3">
                <div class="col-lg-4">
                    <div class="info-label mb-2">Select Duration</div>
                    <select id="dateRange" class="form-select border-radius-sm" onchange="toggleCustomDate()">
                        <option value="daily">Last 24 Hours</option>
                        <option value="weekly">This Week</option>
                        <option value="monthly">This Month</option>
                        <option value="yearly">This Year</option>
                        <option value="custom">Custom Range</option>
                    </select>
                </div>
                
                <div class="col-lg-5" id="customDateSection" style="display: none;">
                    <div class="info-label mb-2">Define Period</div>
                    <div class="input-group">
                        <input type="date" id="startDate" class="form-control">
                        <span class="input-group-text bg-light">to</span>
                        <input type="date" id="endDate" class="form-control">
                    </div>
                </div>

                <div class="col-lg-3">
                    <div d-grid>
                        <button class="btn-modern btn-modern-primary w-100 mt-3" onclick="generateReport()">
                            <i class="fas fa-bolt me-2"></i> Analyze Data
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Table -->
    <div class="custom-card" id="reportResultCard" style="display: none;">
        <div class="custom-card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold"><i class="fas fa-list me-2"></i>Transaction Ledger</span>
            <span class="badge bg-primary-light text-primary" id="recordCount">0 records found</span>
        </div>
        <div class="modern-table-container">
            <table class="modern-table" id="salesReportTable">
                <thead>
                    <tr>
                        <th>Order Reference</th>
                        <th>Created At</th>
                        <th>Gross Amount</th>
                        <th>Coupon / Offer</th>
                        <th>Final Revenue</th>
                    </tr>
                </thead>
                <tbody id="reportTableBody">
                    <!-- Dynamic Data -->
                </tbody>
            </table>
        </div>
    </div>
    
    <div id="noDataPlaceholder" class="text-center py-5">
        <i class="fas fa-chart-line fa-3x text-light mb-3"></i>
        <h4 class="text-muted">No report generated yet</h4>
        <p class="text-muted small">Select a date range and click "Analyze Data" to see results</p>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.23/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script>
    function toggleCustomDate() {
        const dateRange = document.getElementById("dateRange").value;
        const customSection = document.getElementById("customDateSection");
        customSection.style.display = (dateRange === "custom") ? "block" : "none";
    }

    async function generateReport() {
        const dateRange = document.getElementById("dateRange").value;
        let startDate, endDate;
        const today = new Date();

        if (dateRange === "daily") {
            startDate = new Date(today);
            startDate.setHours(0,0,0,0);
            endDate = new Date(today);
            endDate.setHours(23,59,59,999);
        } else if (dateRange === "weekly") {
            startDate = new Date(today);
            startDate.setDate(today.getDate() - 7);
            endDate = new Date(today);
        } else if (dateRange === "monthly") {
            startDate = new Date(today.getFullYear(), today.getMonth(), 1);
            endDate = new Date(today);
        } else if (dateRange === "yearly") {
            startDate = new Date(today.getFullYear(), 0, 1);
            endDate = new Date(today);
        } else {
            const s = document.getElementById("startDate").value;
            const e = document.getElementById("endDate").value;
            if (!s || !e) {
                Swal.fire({ icon: 'warning', title: 'Invalid Dates', text: 'Select both start and end dates' });
                return;
            }
            startDate = new Date(s);
            endDate = new Date(e);
            endDate.setHours(23,59,59,999);
        }

        try {
            const response = await fetch("/admin/salesReport", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    startDate: startDate.toISOString(),
                    endDate: endDate.toISOString(),
                }),
            });

            const data = await response.json();
            if (data.success) {
                displayReport(data.orders, data.summary);
                document.getElementById('noDataPlaceholder').style.display = 'none';
                document.getElementById('reportResultCard').style.display = 'block';
            } else {
                Swal.fire("Error", data.message || "Failed to generate report", 'error');
            }
        } catch (error) {
            Swal.fire("Error", "Server calculation error", 'error');
        }
    }

    function displayReport(orders, summary) {
        const tableBody = document.getElementById("reportTableBody");
        tableBody.innerHTML = "";

        orders.forEach(order => {
            const row = document.createElement("tr");
            row.innerHTML = `
                <td><span class="font-monospace fw-bold">#${order.orderId.slice(-10).toUpperCase()}</span></td>
                <td><span class="text-muted small">${new Date(order.createdAt).toLocaleDateString('en-IN', {day: '2-digit', month: 'short', year: 'numeric'})}</span></td>
                <td class="fw-bold">₹${order.totalPrice.toLocaleString()}</td>
                <td>${order.couponCode ? `<span class="badge bg-primary-light text-primary">${order.couponCode}</span>` : `<span class="text-muted small">None</span>`}</td>
                <td class="text-primary fw-bold">₹${order.finalAmount.toLocaleString()}</td>
            `;
            tableBody.appendChild(row);
        });

        document.getElementById("salesCount").textContent = summary.salesCount;
        document.getElementById("orderAmount").textContent = summary.orderAmount.toLocaleString(undefined, {minimumFractionDigits: 2});
        document.getElementById("discountAmount").textContent = summary.discountAmount.toLocaleString(undefined, {minimumFractionDigits: 2});
        document.getElementById("recordCount").textContent = `${orders.length} transactions found`;
    }

    function downloadPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        
        doc.setFontSize(22);
        doc.setTextColor(79, 70, 229);
        doc.text("FROOTS PEEDIKA", 15, 20);
        
        doc.setFontSize(12);
        doc.setTextColor(100);
        doc.text("SALES PERFORMANCE AUDIT", 15, 28);
        doc.text(`Generated: ${new Date().toLocaleString()}`, 15, 34);

        doc.autoTable({
            startY: 45,
            head: [['Order Ref', 'Date', 'Gross (Rs)', 'Coupon', 'Net (Rs)']],
            body: Array.from(document.getElementById("reportTableBody").children).map(row => 
                Array.from(row.children).map(cell => cell.innerText)
            ),
            theme: 'striped',
            headStyles: { fillColor: [79, 70, 229] }
        });

        const finalY = doc.lastAutoTable.finalY + 15;
        doc.setFontSize(14);
        doc.setTextColor(0);
        doc.text("Executive Summary", 15, finalY);
        doc.setFontSize(11);
        doc.text(`Total Orders: ${document.getElementById("salesCount").innerText}`, 15, finalY + 10);
        doc.text(`Total Revenue: Rs. ${document.getElementById("orderAmount").innerText}`, 15, finalY + 18);
        doc.text(`Total Discounts: Rs. ${document.getElementById("discountAmount").innerText}`, 15, finalY + 26);

        doc.save(`SalesReport_${new Date().toISOString().split('T')[0]}.pdf`);
    }

    function downloadExcel() {
        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.table_to_sheet(document.getElementById("salesReportTable"));
        
        const summary = [
            ["Summary Metrics", ""],
            ["Total Orders", document.getElementById("salesCount").innerText],
            ["Total Revenue", document.getElementById("orderAmount").innerText],
            ["Total Discounts", document.getElementById("discountAmount").innerText]
        ];
        
        XLSX.utils.sheet_add_aoa(ws, summary, { origin: -1 });
        XLSX.utils.book_append_sheet(wb, ws, "Sales Analysis");
        XLSX.writeFile(wb, `SalesData_${Date.now()}.xlsx`);
    }
</script>

<%- include('../partials/admin/footer') %>