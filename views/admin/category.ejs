<%- include("../../views/partials/admin/header") %>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/admin-assets/css/custom-dashboard.css">
    <style>
        .category-form-card {
            position: sticky;
            top: 20px;
        }
    </style>
</head>

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">Category Management</h2>
            <p class="text-muted small mb-0">Organize your product catalog with categories and offers.</p>
        </div>
        <div class="search-wrapper">
            <form action="/admin/category/" method="get">
                <i class="fa fa-search search-icon"></i>
                <input type="text" class="modern-search-input" placeholder="Search categories..." name="search" value="<%= locals.search || '' %>">
            </form>
        </div>
    </div>

    <div class="row g-4">
        <!-- Add Category Form -->
        <div class="col-lg-4">
            <div class="custom-card category-form-card">
                <div class="custom-card-header">
                    <span class="fw-bold"><i class="fas fa-plus-circle me-2"></i>Add Category</span>
                </div>
                <div class="custom-card-body">
                    <form id="addCategoryForm">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Category Name</label>
                            <input type="text" name="name" class="form-control form-control-sm" placeholder="e.g. Fresh Fruits" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Description</label>
                            <textarea name="description" class="form-control form-control-sm" rows="3" placeholder="Category description..." required></textarea>
                        </div>
                        <button class="btn-modern btn-modern-primary w-100 py-2" type="submit">
                            Create Category
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Category List -->
        <div class="col-lg-8">
            <div class="custom-card">
                <div class="custom-card-header">
                    <span class="fw-bold"><i class="fas fa-list me-2"></i>Category List</span>
                </div>
                <div class="modern-table-container">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Category Details</th>
                                <th>Offer %</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% categories.forEach((category) => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark text-truncate-custom" style="max-width: 180px;"><%= category.name %></span>
                                            <span class="text-muted small text-truncate-custom" style="max-width: 250px;"><%= category.description %></span>
                                        </div>
                                    </td>
                                    <td data-label="Offer">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold <%= category.categoryOffer > 0 ? 'text-success' : 'text-muted' %>">
                                                <%= category.categoryOffer > 0 ? `${category.categoryOffer}%` : '0%' %>
                                            </span>
                                            <% if (!category.categoryOffer || category.categoryOffer === 0) { %>
                                                <button class="btn btn-sm btn-link p-0 text-primary" onclick="addOffer('<%= category._id %>')">Add</button>
                                            <% } else { %>
                                                <button class="btn btn-sm btn-link p-0 text-info" onclick="editOffer('<%= category._id %>', '<%= category.categoryOffer %>')">Edit</button>
                                                <button class="btn btn-sm btn-link p-0 text-danger" onclick="deleteOffer('<%= category._id %>')">Remove</button>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td data-label="Status">
                                        <% if (category.isListed) { %>
                                            <span class="badge bg-success">Listed</span>
                                        <% } else { %>
                                            <span class="badge bg-danger">Unlisted</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div class="dropdown">
                                            <button class="btn-modern btn-modern-neutral py-1 px-2" type="button" data-toggle="dropdown">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-right shadow border-0">
                                                <a class="dropdown-item" href="#" onclick="editCategory('<%= category._id %>', '<%= category.name %>', '<%= category.description %>')">
                                                    <i class="fas fa-edit me-2 text-muted"></i> Edit
                                                </a>
                                                <div class="dropdown-divider"></div>
                                                <% if (category.isListed) { %>
                                                    <a class="dropdown-item text-danger" href="#" onclick="unlistCategory('<%= category._id %>')">
                                                        <i class="fas fa-eye-slash me-2"></i> Unlist
                                                    </a>
                                                <% } else { %>
                                                    <a class="dropdown-item text-success" href="#" onclick="listCategory('<%= category._id %>')">
                                                        <i class="fas fa-eye me-2"></i> List
                                                    </a>
                                                <% } %>

                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            <nav class="mt-4">
                <ul class="modern-pagination">
                    <% for (let i=1; i <=totalPages; i++) { %>
                        <li class="modern-page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="modern-page-link" href="?page=<%= i %>"><%= i %></a>
                        </li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Add Category
    document.getElementById('addCategoryForm').addEventListener('submit', function(e) {
        e.preventDefault();
        fetch('/admin/addCategory', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(this)))
        }).then(res => res.json()).then(data => {
            if(data.success) Swal.fire('Success', data.message, 'success').then(() => location.reload());
            else Swal.fire('Error', data.message, 'error');
        });
    });

    // Edit Category
    function editCategory(id, name, description) {
        Swal.fire({
            title: 'Edit Category',
            html: `
                <input id="swal-name" class="swal2-input" value="${name}" placeholder="Name">
                <textarea id="swal-desc" class="swal2-textarea" placeholder="Description">${description}</textarea>
            `,
            showCancelButton: true,
            preConfirm: () => ({
                name: document.getElementById('swal-name').value,
                description: document.getElementById('swal-desc').value
            })
        }).then(result => {
            if(result.isConfirmed) {
                fetch(`/admin/editCategory/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(result.value)
                }).then(res => res.json()).then(data => {
                    if(data.success) location.reload();
                    else Swal.fire('Error', data.message, 'error');
                });
            }
        });
    }

    // List/Unlist
    function unlistCategory(id) {
        Swal.fire({ title: 'Unlist Category?', icon: 'warning', showCancelButton: true }).then(r => {
            if(r.isConfirmed) fetch(`/admin/listCategory?id=${id}`).then(() => location.reload());
        });
    }
    function listCategory(id) {
        Swal.fire({ title: 'List Category?', icon: 'info', showCancelButton: true }).then(r => {
            if(r.isConfirmed) fetch(`/admin/unListCategory?id=${id}`).then(() => location.reload());
        });
    }

    // Offer management
    async function addOffer(categoryId) {
        const { value: p } = await Swal.fire({ title: 'Add Offer %', input: 'number', inputAttributes: {min:1, max:99}, showCancelButton: true });
        if(p) fetch('/admin/addCategoryOffer', {
            method:'PATCH', headers:{'Content-Type':'application/json'}, body:JSON.stringify({categoryId, percentage:parseInt(p)})
        }).then(res => res.json()).then(data => data.status ? location.reload() : Swal.fire('Error', data.message, 'error'));
    }

    function deleteCategory(id) {
        Swal.fire({ title: 'Delete Category?', text: 'This action is permanent!', icon: 'error', showCancelButton: true }).then(r => {
            if(r.isConfirmed) fetch(`/admin/deleteCategory/${id}`, { method:'DELETE' }).then(() => location.reload());
        });
    }
</script>

<%- include("../../views/partials/admin/footer") %>