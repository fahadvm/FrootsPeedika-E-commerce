<%- include("../../views/partials/admin/header") %>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/admin-assets/css/custom-dashboard.css">
</head>

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">Order Management</h2>
            <p class="text-muted small mb-0">Track and fulfill your customer orders from here.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn-modern btn-modern-neutral" onclick="window.location.reload()">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    <div class="custom-card">
        <div class="custom-card-header">
            <span class="fw-bold"><i class="fas fa-list me-2"></i>Total Orders: <%= orders.length %></span>
        </div>
        <div class="modern-table-container">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Order Details</th>
                        <th>Customer</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(orders && orders.length > 0){ %>
                        <% for(let i=0; i<orders.length; i++){ %>
                            <tr>
                                <td data-label="Order ID">
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold text-dark">#<%= orders[i].orderId.slice(-6).toUpperCase() %></span>
                                    </div>
                                </td>
                                <td data-label="Customer Name">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="user-avatar" style="width:24px; height:24px; font-size:10px;">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <span class="text-dark text-truncate-custom" style="max-width: 120px;"><%= orders[i].address.name %></span>
                                    </div>
                                </td>
                                <td data-label="Total">
                                    <div class="fw-bold text-dark">₹<%= orders[i].finalAmount.toLocaleString() %></div>
                                </td>
                                <td data-label="Status">
                                    <% 
                                        let statusClass = 'bg-secondary';
                                        if(orders[i].status === 'Delivered') statusClass = 'bg-success';
                                        if(['Pending', 'Shipped'].includes(orders[i].status)) statusClass = 'bg-info';
                                        if(['Cancelled', 'Returned'].includes(orders[i].status)) statusClass = 'bg-danger';
                                    %>
                                    <span class="badge <%= statusClass %>"><%= orders[i].status %></span>
                                </td>
                                <td data-label="Date">
                                    <div class="text-muted small">
                                        <%= new Date(orders[i].createdAt).toLocaleDateString('en-GB') %>
                                    </div>
                                </td>
                                <td data-label="Actions">
                                    <div class="d-flex gap-2">
                                        <a href="/admin/orders/<%= orders[i]._id %>" class="btn-modern btn-modern-neutral py-1 px-2" style="font-size: 11px;">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                        <button class="btn-modern btn-modern-primary py-1 px-2" style="font-size: 11px;" onclick="showStatusUpdateModal('<%= orders[i]._id %>', '<%= orders[i].status %>')">
                                            Update
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="fas fa-box-open fa-3x text-muted mb-3 d-block"></i>
                                <span class="text-muted">No orders found in the system.</span>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="custom-card-body pt-0">
            <nav class="modern-pagination">
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="modern-page-item <%= currentPage == i ? 'active' : '' %>">
                        <a class="modern-page-link" href="?page=<%= i %>"><%= i %></a>
                    </li>
                <% } %>
            </nav>
        </div>
    </div>
</div>

<!-- Modal for Status Update -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    async function showStatusUpdateModal(orderId, currentStatus) {
        const { value: newStatus } = await Swal.fire({
            title: 'Update Order Status',
            input: 'select',
            inputOptions: {
                'Pending': 'Pending',
                'Shipped': 'Shipped',
                'Delivered': 'Delivered',
                'Cancelled': 'Cancelled'
            },
            inputValue: currentStatus,
            showCancelButton: true,
            confirmButtonColor: '#4f46e5',
            inputValidator: (value) => {
                return new Promise((resolve) => {
                    resolve()
                })
            }
        });

        if (newStatus && newStatus !== currentStatus) {
            updateStatus(orderId, newStatus);
        }
    }

    function updateStatus(orderId, status) {
        fetch('/admin/orders/update-status', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId, status })
        })
        .then(res => res.json())
        .then(data => {
            if(data.success) {
                Swal.fire('Success', 'Order status updated', 'success').then(() => window.location.reload());
            } else {
                Swal.fire('Error', data.message || 'Update failed', 'error');
            }
        });
    }
</script>

<%- include("../../views/partials/admin/footer") %>