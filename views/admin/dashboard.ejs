<%- include("../../views/partials/admin/header") %>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/admin-assets/css/custom-dashboard.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .icon-blue { background-color: #eef2ff; color: #4f46e5; }
        .icon-green { background-color: #ecfdf5; color: #059669; }
        .icon-orange { background-color: #fff7ed; color: #ea580c; }
        .icon-red { background-color: #fef2f2; color: #dc2626; }
        .icon-purple { background-color: #f5f3ff; color: #7c3aed; }

        .time-filter-btn {
            padding: 0.35rem 1rem;
            font-size: 0.8rem;
            background: #fff;
            border: 1px solid #e5e7eb;
            color: #4b5563;
        }
        .time-filter-btn.active {
            background: #4f46e5;
            color: #fff;
            border-color: #4f46e5;
        }
    </style>
</head>

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">Dashboard Overview</h2>
            <p class="text-muted small mb-0">Welcome back! Here's what's happening with your store today.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn-modern btn-modern-neutral" onclick="window.location.reload()">
                <i class="fas fa-sync-alt"></i> Refresh Data
            </button>
            <a href="/admin/salesReport" class="btn-modern btn-modern-primary">
                <i class="fas fa-file-export"></i> Sales Report
            </a>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon icon-blue">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <div class="stats-info">
                    <div class="stats-label">Total Orders</div>
                    <div class="stats-value"><%= dashboardData.orderCount %></div>
                    <div class="stats-change up"><i class="fas fa-arrow-up"></i> 12.5% <span class="text-muted">vs last month</span></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon icon-green">
                    <i class="fas fa-rupee-sign"></i>
                </div>
                <div class="stats-info">
                    <div class="stats-label">Total Revenue</div>
                    <div class="stats-value">₹<%= dashboardData.totalRevenue.toLocaleString() %></div>
                    <div class="stats-change up"><i class="fas fa-arrow-up"></i> 8.2% <span class="text-muted">vs last month</span></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon icon-orange">
                    <i class="fas fa-box"></i>
                </div>
                <div class="stats-info">
                    <div class="stats-label">Total Products</div>
                    <div class="stats-value"><%= dashboardData.productCount %></div>
                    <div class="stats-change text-muted">Active items in catalog</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="stats-icon icon-purple">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stats-info">
                    <div class="stats-label">Customers</div>
                    <div class="stats-value"><%= dashboardData.userCount %></div>
                    <div class="stats-change up"><i class="fas fa-arrow-up"></i> 4.1% <span class="text-muted">vs last month</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="custom-card chart-card h-100">
                <div class="custom-card-header">
                    <span class="fw-bold"><i class="fas fa-chart-line me-2"></i>Revenue Overview</span>
                    <div class="btn-group shadow-sm">
                        <button class="time-filter-btn rounded-start" id="weeklyBtn" onclick="updateSalesChart('weekly')">Week</button>
                        <button class="time-filter-btn" id="monthlyBtn" onclick="updateSalesChart('monthly')">Month</button>
                        <button class="time-filter-btn rounded-end" id="yearlyBtn" onclick="updateSalesChart('yearly')">Year</button>
                    </div>
                </div>
                <div class="custom-card-body">
                    <div class="chart-wrapper">
                        <canvas id="salesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="custom-card chart-card h-100">
                <div class="custom-card-header">
                    <span class="fw-bold"><i class="fas fa-chart-pie me-2"></i>Order Status</span>
                </div>
                <div class="custom-card-body">
                    <div class="chart-wrapper">
                        <canvas id="orderStatusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tables Row -->
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="custom-card">
                <div class="custom-card-header">
                    <span class="fw-bold"><i class="fas fa-crown me-2"></i>Best Selling Products</span>
                    <select class="form-select form-select-sm w-auto" id="productFilter" onchange="updateTopSelling(this.value)">
                        <option value="products">Top Products</option>
                        <option value="categories">Top Categories</option>
                    </select>
                </div>
                <div class="modern-table-container">
                    <table class="modern-table">
                        <thead id="topSellingHeader">
                            <tr>
                                <th>Product Details</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Sold</th>
                            </tr>
                        </thead>
                        <tbody id="topSellingBody">
                            <!-- Populated via script or EJS loop -->
                        </tbody>
                    </table>
                    <div id="topSellingLoading" class="text-center py-4 d-none">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="custom-card">
                <div class="custom-card-header">
                    <span class="fw-bold"><i class="fas fa-history me-2"></i>Recent Orders</span>
                    <a href="/admin/orders" class="btn btn-sm btn-link text-primary text-decoration-none">View All</a>
                </div>
                <div class="modern-table-container">
                    <table class="modern-table">
                                <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer Name</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (dashboardData.recentOrders && dashboardData.recentOrders.length > 0) { %>
                                <% dashboardData.recentOrders.forEach(order => { %>
                                    <tr>
                                        <td><span class="fw-bold text-muted small">#<%= order.orderId.slice(-6).toUpperCase() %></span></td>
                                        <td><span class="text-dark text-truncate-custom" style="max-width: 100px;"><%= order.address.name %></span></td>
                                        <td class="small fw-bold">₹<%= order.finalAmount.toLocaleString() %></td>
                                        <td>
                                            <% 
                                                let badgeClass = 'bg-secondary';
                                                if(order.status === 'Delivered') badgeClass = 'bg-success';
                                                if(['Pending', 'Shipped', 'Confirmed'].includes(order.status)) badgeClass = 'bg-info';
                                                if(['Cancelled', 'Returned'].includes(order.status)) badgeClass = 'bg-danger';
                                            %>
                                            <span class="badge <%= badgeClass %>"><%= order.status %></span>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center py-4">No recent orders found</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Initialize Dashboard Charts
    let salesChart;
    let statusChart;

    document.addEventListener('DOMContentLoaded', function() {
        initSalesChart();
        initStatusChart();
        updateTopSelling('products');
        
        // Set default active period
        document.getElementById('monthlyBtn').classList.add('active');
    });

    function initSalesChart() {
        const ctx = document.getElementById('salesChart').getContext('2d');
        const salesData = <%- JSON.stringify(dashboardData.salesData) %>;
        const salesLabels = <%- JSON.stringify(dashboardData.salesLabels) %>;

        const gradient = ctx.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(79, 70, 229, 0.2)');
        gradient.addColorStop(1, 'rgba(79, 70, 229, 0.0)');

        salesChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: salesLabels,
                datasets: [{
                    label: 'Revenue',
                    data: salesData,
                    borderColor: '#4f46e5',
                    backgroundColor: gradient,
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#4f46e5',
                    pointBorderColor: '#fff',
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { 
                        grid: { borderDash: [5, 5] },
                        ticks: {
                            callback: function(v) { return '₹' + v.toLocaleString(); }
                        }
                    }
                }
            }
        });
    }

    function initStatusChart() {
        const ctx = document.getElementById('orderStatusChart').getContext('2d');
        const statusData = <%- JSON.stringify(dashboardData.orderStatusData) %>;
        const statusLabels = <%- JSON.stringify(dashboardData.orderStatusLabels) %>;

        statusChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusData,
                    backgroundColor: ['#10b981', '#3b82f6', '#4f46e5', '#f59e0b', '#ef4444', '#6b7280'],
                    borderWidth: 0,
                    hoverOffset: 15
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { padding: 20, usePointStyle: true }
                    }
                },
                cutout: '75%'
            }
        });
    }

    function updateSalesChart(period) {
        // UI feedback
        document.querySelectorAll('.time-filter-btn').forEach(b => b.classList.remove('active'));
        document.getElementById(period + 'Btn').classList.add('active');

        fetch(`/admin/api/sales-data?period=${period}`)
            .then(res => res.json())
            .then(data => {
                salesChart.data.labels = data.labels;
                salesChart.data.datasets[0].data = data.data;
                salesChart.update();
            });
    }

    function updateTopSelling(type) {
        const body = document.getElementById('topSellingBody');
        const header = document.getElementById('topSellingHeader');
        const loader = document.getElementById('topSellingLoading');

        body.classList.add('opacity-50');
        loader.classList.remove('d-none');

        fetch(`/admin/api/top-selling?type=${type}`)
            .then(res => res.json())
            .then(data => {
                loader.classList.add('d-none');
                body.classList.remove('opacity-50');
                body.innerHTML = '';

                if (type === 'products') {
                    header.innerHTML = `<tr><th>Product Details</th><th>Category</th><th>Price</th><th>Sold</th></tr>`;
                    data.products.forEach(p => {
                        body.innerHTML += `
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="/${p.image}" class="rounded shadow-sm" style="width:32px; height:32px; object-fit:cover">
                                        <span class="fw-semibold text-dark text-truncate-custom" style="max-width: 150px;">${p.name}</span>
                                    </div>
                                </td>
                                <td><span class="modern-badge text-truncate-custom" style="background:#f3f4f6; max-width: 80px;">${p.category}</span></td>
                                <td class="fw-bold small">₹${p.price.toLocaleString()}</td>
                                <td class="text-primary fw-bold small">${p.soldCount}</td>
                            </tr>
                        `;
                    });
                } else {
                    header.innerHTML = `<tr><th>Category Name</th><th>Item Count</th><th>Popularity Score</th><th>Total Units Sold</th></tr>`;
                    data.categories.forEach(c => {
                        body.innerHTML += `
                            <tr>
                                <td><span class="fw-bold text-dark">${c.name}</span></td>
                                <td>${c.productCount}</td>
                                <td><div class="progress" style="height:6px; width:100px"><div class="progress-bar" style="width:${Math.min(c.soldCount * 2, 100)}%"></div></div></td>
                                <td class="fw-bold">${c.soldCount} Units</td>
                            </tr>
                        `;
                    });
                }
            });
    }
</script>

<%- include("../../views/partials/admin/footer") %>